{
  "name": "voice-effect",
  "version": "1.0.0",
  "description": "Real-time voice effect processor",
  "main": "main.js",
  "author": "Sedat Ergoz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "npx electron-builder --win --x64 --publish never",
    "build:portable": "npx electron-builder --win portable --x64 --publish never",
    "build:setup": "npx electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.voiceeffect.app",
    "productName": "VoiceEffect",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "presets/",
        "to": "presets/"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "data/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "signAndEditExecutable": false
  }
}
