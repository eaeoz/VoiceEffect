{
  "name": "voice-effect",
  "version": "2.0.0",
  "description": "Real-time voice effect processor",
  "main": "main.js",
  "author": "Sedat Ergoz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:icon && npx electron-builder --win --x64 --publish never",
    "build:portable": "npm run build:icon && npx electron-builder --win portable --x64 --publish never",
    "build:setup": "npm run build:icon && npx electron-builder --win nsis --x64 --publish never",
    "build:icon": "node create-icon.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.voiceeffect.app",
    "productName": "VoiceEffect",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "presets/",
        "to": "presets/"
      },
      {
        "from": "data/",
        "to": "data/"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "data/icon.ico",
      "signAndEditExecutable": false,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "data/icon.ico",
      "uninstallerIcon": "data/icon.ico",
      "installerHeaderIcon": "data/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "shortcutName": "VoiceEffect"
    },
    "portable": {
      "artifactName": "${productName}_portable_${version}.${ext}"
    }
  }
}
